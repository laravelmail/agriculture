10#5000#M$M#rs$AOn4CLAaUwvWWgvxc0JF5A1FbD6ZpimttQ|160#90#95#5#5#5000#M$M#rs$AOn4CLAor_tJraZyswbvvqQd1SecFJQ7nA","recommendedLevel":2,"highResolutionRecommendedLevel":2}},"microformat":{"playerMicroformatRenderer":{"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/zRzDTrovOY0/maxresdefault.jpg","width":1280,"height":720}]},"embed":{"iframeUrl":"https://www.youtube.com/embed/zRzDTrovOY0","width":1280,"height":720},"title":{"simpleText":"Amazing Onion Farming and Harvesting Techniques - Amazing Onion Cultivation"},"description":{"simpleText":"Click Here To See :  Raisin,Dates,Walnut Processing  - https://youtu.be/6aCleihLoDA \nOnion Farming and Harvesting Techniques - Amazing Onion Farming\nOnion Farming, Planting, Care, Harvesting - A Full Guide, Amazing Modern Automatic Onion Farming Technology\n\nStart seeds indoors about 6 weeks before transplanting to the garden. Think of onions as a leaf crop, not a root crop. When planting onion sets, don't bury them more than 1 inch under the soil. For sets or transplants, space plants 4 to 5 inches apart in rows 12 to 18 inches apart.\n\nCredit : Media Plan and Gite Masdescombes and nitk7731\n\nIf you are the owner, please send me a email or comment on the video. I will follow your request as soon as i read. \n\n Please comment below , Which Cultivation and Farming video you need to watch ?\r\n\r\n❤  SUBSCRIBE TODAY  ❥  SUBSCRIBE  ❥  SUBSCRIBE NOW  ❤\r\n\rYouTube -: http://www.youtube.com/c/CompletePicturesOfficial\ntwitter : https://twitter.com/CompletePics \n\nIf you enjoyed watching subscribe for a new video every week.\r\nSubscribe: http://goo.gl/Wvp7qV\nwatch :  Dry Fruits Processing Technology - https://youtu.be/29o6-lgmOXQ\nGarlic Cultivation : youtu.be/i34ctoGe_c8"},"lengthSeconds":"470","ownerProfileUrl":"http://www.youtube.com/@CompleteAgriculture","externalChannelId":"UC3OmAtvd-9AsBDEPIv9JeQQ","isFamilySafe":true,"availableCountries":["AD","AE","AF","AG","AI","AL","AM","AO","AQ","AR","AS","AT","AU","AW","AX"